# ============================================================
#  백엔드 환경 변수 — 이 파일을 복사해서 env/.env.development 로 쓰세요
#     mkdir -p env && cp .env.example env/.env.development
#
#  ⚠️ env/ 폴더는 gitignore 대상입니다. 실제 비밀값은 절대 커밋하지 마세요.
#  ⚠️ NODE_ENV 는 기본값이 'development' 입니다. 배포에서 빼먹지 마세요.
# ============================================================

# ── 서버 ──────────────────────────────────────────────────
NODE_ENV=development
PORT=5010

# ── DB ────────────────────────────────────────────────────
# docker compose 를 쓰면 기본값이 아래와 같습니다 (postgres 컨테이너, DB명 docthru_bp).
# ⚠️ 시드 안전장치가 DB명(docthru_bp)을 확인하므로 이름을 그대로 두세요.
DATABASE_URL=postgresql://docthru:docthru@localhost:5432/docthru_bp
# Supabase Session pooler 로 바꿀 때는 ?schema=public 같은 파라미터를 붙이지 않습니다.
#   postgresql://<user>:<pass>@<ref>.pooler.supabase.com:5432/postgres

# ── 인증 비밀키 (32자 이상) ────────────────────────────────
# ⚠️ 개발용 값입니다. 운영에서는 새로 생성해 주세요.
#    openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-at-least-32chars
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-at-least-32chars

# ── 배포·보안 ─────────────────────────────────────────────
# PG 커넥션 상한. 배포 시 --max-instances 와 맞춰 잡습니다 (예: 2 × 5 = 10).
DB_POOL_MAX=5

# 개발 계정 로그인 스위치. true 여도 NODE_ENV=production 이면 열리지 않습니다.
#   · 로컬/docker compose: true
#   · Cloud Run 등 운영:    설정하지 말 것 (기본 false)
ENABLE_DEV_LOGIN=true

# ── 프론트 연동 ───────────────────────────────────────────
CLIENT_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# OAuth 콜백 URL 을 만들 때 쓰인다. "/api/v1" 을 포함해야 한다.
API_BASE_URL=http://localhost:5010/api/v1

# ── (선택) Google OAuth ──────────────────────────────────────
# 값을 비워 두어도 서버는 정상 기동해요. 대신 GET /auth/google 이 302 대신 400 으로
# "자격 증명을 채워 달라"고 안내합니다 (크래시 아님).
#   · 발급: Google Cloud Console > API 및 서비스 > 사용자 인증 정보 > OAuth 클라이언트 ID
#   · 승인된 리디렉션 URI: 아래 GOOGLE_REDIRECT_URI 와 같은 주소를 등록해 주세요.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
#
# 비우면 API_BASE_URL + /auth/google/callback 으로 자동 생성돼요.
# GOOGLE_REDIRECT_URI=http://localhost:5010/api/v1/auth/google/callback
#
# state 서명 키(32자 이상). 비우면 JWT_ACCESS_SECRET 을 대신 사용해요.
# 운영에서는 목적을 분리하려고 따로 두는 것을 권해요.
# OAUTH_STATE_SECRET=