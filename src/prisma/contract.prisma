// use prisma-8
//
// 8테이블 계약 — Google OAuth + 이메일 인증을 함께 쓰는 팀 결정을 반영했습니다.
//
//   1. oauth_accounts → users 병합 (provider · providerAccountId)
//   2. challenge_applications → challenges 병합 (status)
//   3. drafts → challenge_participants 병합 (draft*)
//   4. users 에 deletedAt(소프트 삭제) · tokenVersion(세션 무효화) 추가
//   5. password_reset_tokens 추가 (30분·1회용·SHA-256 해시)
//
// 공개 챌린지 목록은 status IN (IN_PROGRESS, CLOSED) + deletedAt IS NULL,
// 어드민 신청 목록은 status IN (PENDING, REJECTED, CANCELLED) + deletedAt IS NULL 로 조회해 주세요.
// 사용자 조회도 기본으로 deletedAt IS NULL 을 붙여요 — 탈퇴 계정은 인증·목록에서 제외합니다.
native_enum UserRole {
  USER = "USER"
  ADMIN = "ADMIN"
}

native_enum UserGrade {
  NORMAL = "NORMAL"
  EXPERT = "EXPERT"
}

native_enum OAuthProvider {
  GOOGLE = "GOOGLE"
}

native_enum Category {
  NEXT_JS = "NEXT_JS"
  MODERN_JS = "MODERN_JS"
  API = "API"
  WEB = "WEB"
  CAREER = "CAREER"
}

native_enum DocumentType {
  OFFICIAL = "OFFICIAL"
  BLOG = "BLOG"
  BOOK = "BOOK"
  OTHER = "OTHER"
}

// 신청과 챌린지를 한 테이블에서 표현하는 통합 상태예요.
//   PENDING → IN_PROGRESS → CLOSED
//   PENDING → REJECTED
//   PENDING → CANCELLED
//
// ⚠️ 기존 DB의 ChallengeStatus(IN_PROGRESS, CLOSED)에 값을 append하는 순서예요.
//    Postgres enum은 append-only라서, 기존 값을 앞에 다시 쓰면 enum 재생성이 필요합니다.
native_enum ChallengeStatus {
  IN_PROGRESS = "IN_PROGRESS"
  CLOSED = "CLOSED"
  PENDING = "PENDING"
  REJECTED = "REJECTED"
  CANCELLED = "CANCELLED"
}

// ⚠️ 멤버 순서 = DB enum sortorder (Postgres enum은 append-only)
native_enum NotificationType {
  CHALLENGE_APPROVED = "CHALLENGE_APPROVED"
  CHALLENGE_REJECTED = "CHALLENGE_REJECTED"
  CHALLENGE_UPDATED = "CHALLENGE_UPDATED"
  CHALLENGE_DELETED = "CHALLENGE_DELETED"
  WORK_ADDED = "WORK_ADDED"
  FEEDBACK_ADDED = "FEEDBACK_ADDED"
  FEEDBACK_UPDATED = "FEEDBACK_UPDATED"
  CHALLENGE_DEADLINE = "CHALLENGE_DEADLINE"
  FEEDBACK_DELETED = "FEEDBACK_DELETED"
}

model User {
  id                Int                        @id @default(autoincrement())
  email             String                     @unique
  nickname          String                     @unique
  passwordHash      String?

  // Google 소셜 로그인 — 로컬 계정은 두 값이 모두 null 이에요.
  // 같은 구글 계정이 두 사용자에게 연결되지 않도록 복합 unique 를 둡니다.
  provider          pg.enum(OAuthProvider)?
  providerAccountId String?

  role              pg.enum(UserRole)          @default("USER")
  grade             pg.enum(UserGrade)         @default("NORMAL")

  // 세션 무효화 버전 — JWT 의 ver 클레임과 비교해, 값이 달라지면 기존 토큰을 거부해요.
  // 로그아웃(전 기기)·비밀번호 변경·탈퇴 때 1씩 올립니다.
  tokenVersion      Int                        @default(0)
  // 탈퇴는 소프트 삭제 — 챌린지·작업물·피드백 FK 는 보존하고 개인정보만 익명화해요.
  deletedAt         TimestamptzString?

  passwordResetTokens PasswordResetToken[]

  createdChallenges Challenge[]                @relation("ChallengeCreator")
  decidedChallenges Challenge[]                @relation("ChallengeDecider")
  deletedChallenges Challenge[]                @relation("ChallengeDeleter")
  participations    ChallengeParticipant[]
  feedbacks         Feedback[]
  workLikes         WorkLike[]
  notifications     Notification[]             @relation("NotificationReceiver")
  actedNotifications Notification[]            @relation("NotificationActor")

  createdAt         TimestamptzString          @default(now())
  updatedAt         temporal.updatedAtString()

  @@unique([provider, providerAccountId])
  @@index([grade])
  @@map("users")
}

// 비밀번호 재설정 토큰 — 원문은 메일 링크에만 두고 DB 에는 SHA-256 해시만 저장해요.
// expiresAt(30분) 이 지나거나 usedAt 이 채워지면 다시 쓸 수 없습니다.
model PasswordResetToken {
  id        Int               @id @default(autoincrement())
  userId    Int
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String            @unique
  expiresAt TimestamptzString
  usedAt    TimestamptzString?
  createdAt TimestamptzString @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Challenge {
  id              Int                        @id @default(autoincrement())
  title           String
  category        pg.enum(Category)
  documentType    pg.enum(DocumentType)
  sourceUrl       String
  content         String?
  deadline        TimestamptzString
  maxParticipants Int
  status          pg.enum(ChallengeStatus)   @default("PENDING")

  // 신청자 = 챌린지 개설자예요. 승인 후에도 같은 행을 이어서 사용합니다.
  createdById     Int
  createdBy       User                       @relation("ChallengeCreator", fields: [createdById], references: [id], onDelete: Restrict)

  // 승인·거절 판단 기록이에요. 거절 사유는 rejectionReason에 남깁니다.
  rejectionReason String?
  decidedAt       TimestamptzString?
  decidedById     Int?
  decidedBy       User?                      @relation("ChallengeDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  cancelledAt     TimestamptzString?

  // 챌린지 삭제는 소프트 삭제로 남겨요. 삭제한 관리자도 함께 기록합니다.
  deletedAt       TimestamptzString?
  deleteReason    String?
  deletedById     Int?
  deletedBy       User?                      @relation("ChallengeDeleter", fields: [deletedById], references: [id], onDelete: SetNull)

  participants    ChallengeParticipant[]
  notifications   Notification[]

  createdAt       TimestamptzString          @default(now())
  updatedAt       temporal.updatedAtString()

  @@index([status, deadline])
  @@index([status, createdAt])
  @@index([category, documentType])
  @@index([createdById])
  @@index([decidedById])
  @@map("challenges")
}

model ChallengeParticipant {
  id             Int                        @id @default(autoincrement())
  challengeId    Int
  challenge      Challenge                  @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  userId         Int
  user           User                       @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt       TimestamptzString          @default(now())
  abandonedAt    TimestamptzString?

  // 임시저장은 참여 1건당 1개예요. 별도 drafts 테이블 대신 이 행에 함께 보관합니다.
  // 삭제는 draftContent를 null로 되돌리는 방식이라 조인·INSERT/DELETE가 필요 없어요.
  draftContent   String?
  draftCreatedAt TimestamptzString?
  draftUpdatedAt TimestamptzString?

  work           Work[]

  createdAt      TimestamptzString          @default(now())
  updatedAt      temporal.updatedAtString()

  @@unique([challengeId, userId])
  @@index([userId, abandonedAt])
  @@map("challenge_participants")
}

model Work {
  id            Int                        @id @default(autoincrement())
  participantId Int
  participant   ChallengeParticipant       @relation(fields: [participantId], references: [id], onDelete: Cascade)
  content       String
  submittedAt   TimestamptzString          @default(now())

  feedbacks     Feedback[]
  likes         WorkLike[]
  notifications Notification[]

  createdAt     TimestamptzString          @default(now())
  updatedAt     temporal.updatedAtString()

  @@index([participantId])
  @@index([submittedAt])
  @@map("works")
}

model Feedback {
  id        Int                        @id @default(autoincrement())
  workId    Int
  work      Work                       @relation(fields: [workId], references: [id], onDelete: Cascade)
  userId    Int
  user      User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String

  createdAt TimestamptzString          @default(now())
  updatedAt temporal.updatedAtString()

  @@index([workId, createdAt])
  @@index([userId])
  @@map("feedbacks")
}

model WorkLike {
  id        Int               @id @default(autoincrement())
  workId    Int
  work      Work              @relation(fields: [workId], references: [id], onDelete: Cascade)
  userId    Int
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt TimestamptzString @default(now())

  @@unique([workId, userId])
  @@index([userId])
  @@map("work_likes")
}

model Notification {
  id                 Int                       @id @default(autoincrement())
  userId             Int
  user               User                      @relation("NotificationReceiver", fields: [userId], references: [id], onDelete: Cascade)
  type               pg.enum(NotificationType)

  reason             String?

  relatedChallengeId Int?
  relatedChallenge   Challenge?                @relation(fields: [relatedChallengeId], references: [id], onDelete: Cascade)
  relatedWorkId      Int?
  relatedWork        Work?                     @relation(fields: [relatedWorkId], references: [id], onDelete: Cascade)
  actorId            Int?
  actor              User?                     @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  dedupeKey          String?                   @unique
  readAt             TimestamptzString?

  createdAt          TimestamptzString         @default(now())

  @@index([userId, readAt, createdAt])
  @@index([relatedChallengeId])
  @@map("notifications")
}
